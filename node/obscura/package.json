{
  "name": "@obscura/browser",
  "version": "0.1.0",
  "description": "Portable Obscura browser backed by JavaScript and WebAssembly",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "default": "./src/index.mjs"
    }
  },
  "bin": {
    "obscura-browser": "./bin/obscura-browser.mjs"
  },
  "files": [
    "src",
    "bin",
    "wasm",
    "bootstrap.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test ./test/*.test.mjs",
    "pretest": "node ./scripts/prepare-runtime.mjs",
    "prepare:runtime": "node ./scripts/prepare-runtime.mjs",
    "prepare:wasm": "node ./scripts/prepare-wasm.mjs",
    "prepack": "node ./scripts/prepare-runtime.mjs && node ./scripts/prepare-wasm.mjs"
  },
  "license": "Apache-2.0"
}
