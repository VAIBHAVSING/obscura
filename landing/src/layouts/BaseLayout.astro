---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  image?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  image = "/social-card.png",
} = Astro.props;

const site = Astro.site ?? new URL("https://domjet.dev");
const canonical = new URL(canonicalPath, site);
const socialImage = new URL(image, site);
const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Domjet",
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Node.js",
  url: site.toString(),
  description,
  programmingLanguage: ["Rust", "TypeScript", "WebAssembly"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#f4f2ed" />

    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms.txt"
      title="Domjet documentation for language models"
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Domjet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Domjet, the lightweight headless browser for AI agents" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
    <script is:inline>document.documentElement.classList.add("has-js");</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
